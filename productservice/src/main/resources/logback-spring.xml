<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />
    <include resource="org/springframework/boot/logging/logback/console-appender.xml" />

    <springProperty scope="context" name="springAppName" source="spring.application.name"/>

    <appender name="AWS_LOGS" class="ca.pjer.logback.AwsLogsAppender">
        <layout>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </layout>
        <logGroupName>${springAppName}-log-group</logGroupName>
        <logStreamUuidPrefix>${springAppName}-stream-</logStreamUuidPrefix>
        <logRegion>us-east-1</logRegion>

        <cloudWatchEndpoint>http://localstack:4566</cloudWatchEndpoint>
        <accessKeyId>test</accessKeyId>
        <secretAccessKey>test</secretAccessKey>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="AWS_LOGS" />
    </root>
</configuration>